# Token do bot do Telegram (crie um bot com o @BotFather e cole o token aqui)
TELEGRAM_TOKEN=seu_token_aqui

# ID do chat/grupo do Telegram para onde as vagas serão enviadas
CHAT_ID_GRUPO=numero_do_grupo_aqui

# Cloudflare R2 — só necessário rodando como cron job (ex: Render), onde o
# disco não persiste entre execuções. Rodando localmente ou num processo
# contínuo (systemd), pode deixar essas 4 linhas vazias/removidas.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
